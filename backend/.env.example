# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=reservation_api
DB_USERNAME=reservation_user
DB_PASSWORD=reservation_pass

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRATION=3600

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_key_change_in_production_2026

# App Configuration
APP_URL=http://localhost:8080
APP_ENV=development
APP_DEBUG=true

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60
