{
  "info": {
    "name": "Reservation API",
    "description": "Postman Collection for the Reservation API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "tk_live_test_key_travel_agency_2026",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST Login (valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('jwt_token', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@transport.tn\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            }
          }
        },
        {
          "name": "POST Login (invalid password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@transport.tn\",\n  \"password\": \"wrongpassword\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            }
          }
        },
        {
          "name": "POST Login (missing fields)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@transport.tn\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Trajets",
      "item": [
        {
          "name": "GET All Trajets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/trajets",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "trajets"
              ]
            }
          }
        },
        {
          "name": "GET Trajets with Filters",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/trajets?departure=Tunis&destination=Sousse",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "trajets"
              ],
              "query": [
                {
                  "key": "departure",
                  "value": "Tunis"
                },
                {
                  "key": "destination",
                  "value": "Sousse"
                }
              ]
            }
          }
        },
        {
          "name": "GET Trajets with Date",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/trajets?date=2026-10-15",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "trajets"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "2026-10-15"
                }
              ]
            }
          }
        },
        {
          "name": "GET Trajets Unauthorized",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/trajets",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "trajets"
              ]
            }
          }
        }
      ]
